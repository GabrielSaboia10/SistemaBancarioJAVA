# Copie para .env e troque os valores antes de rodar `docker compose up`.
# Nunca faça commit do .env.

DATABASE_USER=banco
DATABASE_PASSWORD=troque-esta-senha

# Mínimo de 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Primeiro administrador (criado só se ainda não existir nenhum)
ADMIN_CPF=000.000.000-00
ADMIN_SENHA=troque-esta-senha

# Origens que podem chamar a API direto (separadas por vírgula).
# O site servido pelo nginx não precisa (mesmo domínio). O app Android (Capacitor) usa https://localhost.
CORS_ORIGINS=http://localhost:8080,https://localhost
